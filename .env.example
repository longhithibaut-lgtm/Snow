# Copy to .env and fill in. Never commit .env.

# Alpaca paper trading keys (https://app.alpaca.markets > Paper Trading > API Keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# "iex" (free) or "sip" (paid data plan)
ALPACA_DATA_FEED=iex

# Live trading keys, used only with `snow run --live` AND SNOW_LIVE_CONFIRM=yes
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
SNOW_LIVE_CONFIRM=no

# Optional alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Optional LLM filter (TradingAgents): the key of the provider you configure
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
